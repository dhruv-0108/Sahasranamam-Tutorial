  },
  "shlokas": [
    {
      "shloka_number": 1,
      "full_sanskrit": "अपराधसहस्त्राणि क्रियन्तेऽहर्निशं मया । दासोऽयमिति मां मत्वा क्षमस्व परमेश्वरि ॥१॥",
      "sandhi_split_sanskrit": "अपराधसहस्राणि | क्रियन्ते | अहर्निशम् | मया | दासः | अयम् | इति | माम् | मत्वा | क्षमस्व | परमेश्वरि",
      "iast_transliteration": "aparādhasahasrāṇi kriyante'harniśaṃ mayā | dāso'yamiti māṃ matvā kṣamasva parameśvari ||1||",
      "meaning_english": "Thousands of offenses are committed by me day and night. Thinking of me as Your servant, forgive me, O Supreme Goddess.",
      "meaning_hindi": "परमेश्वरी! मेरे द्वारा रात-दिन हजारों अपराध होते रहते हैं। 'यह मेरा दास है' – ऐसा समझकर मेरे उन अपराधों को तुम कृपापूर्वक क्षमा करो।",
      "audio_start_ms": 10000,
      "audio_end_ms": 20000,
