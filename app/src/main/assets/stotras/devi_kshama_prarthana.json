{
  "stotra": {
    "id": "devi_kshama_prarthana",
    "title_devanagari": "देवी अपराधक्षमापन प्रार्थना (क्षमा-प्रार्थना)",
    "title_english": "Devi Kshama Prarthana",
    "category": "Stotras",
    "deity": "Devi",
    "total_shlokas": 8,
    "description": "Devi Kshama Prarthana is a beautiful prayer from the Devi Mahatmyam / Durga Saptashati seeking forgiveness for any errors or deficiencies committed during worship, rituals, or chanting.",
