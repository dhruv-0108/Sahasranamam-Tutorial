    {
      "shloka_number": 2,
      "full_sanskrit": "आवाहनं न जानामि न जानामि विसर्जनम् । पूजां चैव न जानामि क्षम्यतां परमेश्वरि ॥२॥",
      "sandhi_split_sanskrit": "आवाहनम् | न | जानामि | न | जानामि | विसर्जनम् | पूजाम् | च | एव | न | जानामि | क्षम्यताम् | परमेश्वरि",
      "iast_transliteration": "āvāhanaṃ na jānāmi na jānāmi visarjanam | pūjāṃ caiva na jānāmi kṣamyatāṃ parameśvari ||2||",
      "meaning_english": "I do not know how to invoke You, nor do I know how to bid You farewell. I do not even know how to perform worship. Forgive me, O Supreme Goddess.",
      "meaning_hindi": "परमेश्वरी! मैं आवाहन (बुलाना) नहीं जानता, विसर्जन करना नहीं जानता तथा पूजा करने का ढंग भी नहीं जानता। मुझे क्षमा करो।",
      "audio_start_ms": 20000,
      "audio_end_ms": 30000,
