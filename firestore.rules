rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Stotras and Shlokas are publicly readable for all app users
    match /stotras/{stotraId} {
      allow read: if true;
      allow write: if false; // Admin only

      match /shlokas/{shlokaId} {
        allow read: if true;
        allow write: if false;

        match /padas/{padaId} {
          allow read: if true;
          allow write: if false;
        }
      }
    }

    // User SRS Flashcard Learning Progress is 100% private to the authenticated user
    match /users/{userId}/srs_progress/{shlokaId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
